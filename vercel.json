{
  "version": 2,
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/resume.pdf",
      "headers": {
        "Content-Type": "application/pdf",
        "Content-Disposition": "inline; filename=\"Alexandra_Reyes_Resume.pdf\"",
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "/resume.pdf"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
